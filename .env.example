# SUPABASE_SERVICE_ROLE_KEY=service_role_xxx
# KIS_APP_KEY=
# KIS_APP_SECRET=

# App config (contract multiplier lives here as fallback; DB app_settings is source of truth)
K200_CONTRACT_MULTIPLIER=250000
TZ=Asia/Seoul
